{
  "name": "@resonatehq/effect",
  "version": "0.1.0",
  "description": "Resonate SDK for Effect",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check",
    "check:fix": "biome check --write",
    "fmt": "biome format --write"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^22.20.1",
    "effect": "4.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0"
}
